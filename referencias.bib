@article{villarejos_hepatitis_1972,
	title = {Hepatitis epidemic in a hyperendemic zone of {Costa} {Rica}. {Report} of a second outbreak within four years},
	volume = {96},
	issn = {0002-9262},
	url = {https://doi.org/10.1093/oxfordjournals.aje.a121467},
	doi = {10.1093/oxfordjournals.aje.a121467},
	abstract = {Villarejos, V. M. (LSU-ICMRT, Apdo. 10155, San José, Costa Rica), J. A. Arguedas, A. Gutiérrez, E. Eduarte, G. Vargas and J. A. Osborne. Hepatitis epidemic in a hyperendemic zone of Costa Rica. Report of a second outbreak within four years. Am J Epidemiol 96: 361–371, 1972.—Four years after an outbreak of type B hepatitis in a highly endemic zone of Costa Rica, a second and larger epidemic of viral hepatitis occurred in the two counties involved. The epidemic ran a protracted course, lasted throughout both rainy and dry seasons, and reached attack rates as high as 5\% in certain districts. Over 36\% of the 771 cases observed were children under 5 years and 92\% were less than 15 years old. The pattern of age-specific attack rates in rural and urban areas revealed belated acquisition of immunity in sparsely populated rural areas, indicating a distribution of susceptibles in accord with the degree of exposure during endemic periods. The overall ratio of clinically overt to subclinical or inapparent infection was approximately 1:1. The disease was anicteric in a large proportion of cases (37\%). Hepatitis B (Australia) antigen was found in 5.3\% of the sera tested, predominantly in adult cases, which probably expressed only the endemic occurrence of this type of disease in the area, independent of the epidemic infection. No common source or vehicle was detected; person-to-person contact was the most likely mode of spread. The epidemiologic and clinical data characterize this as an epidemic of infectious hepatitis, which occurred in a highly endemic zone.},
	number = {5},
	urldate = {2026-08-11},
	journal = {American Journal of Epidemiology},
	author = {VILLAREJOS, VÍCTOR M. and ARGUEDAS, JORGE A. and GUTIÉRREZ, ALVARO and EDUARTE, EDUARDO and GILBERTO VARGAS, A. and OSBORNE, JORGE A.},
	month = nov,
	year = {1972},
	pages = {361--371},
}

@article{kuete_antimicrobial_2008,
	title = {Antimicrobial activity of the crude extracts and compounds from \textit{{Ficus} chlamydocarpa} and \textit{{Ficus} cordata} ({Moraceae})},
	volume = {120},
	issn = {0378-8741},
	url = {https://www.sciencedirect.com/science/article/pii/S0378874108004066},
	doi = {10.1016/j.jep.2008.07.026},
	abstract = {The aim of this study was to evaluate the antimicrobial activity of the methanol extracts from Ficus chlamydocarpa (FCR), Ficus cordata (FCB), mixture of the two plants (FCM), as well as that of the isolated flavonoids Alpinumisoflavone (2), Genistein (3), Laburnetin (4), Luteolin (5) (isolated from FCR), Catechin (7) and Epiafzelechin (8) (isolated from FCB). Mycobacteria, fungi, Gram-positive and Gram-negative bacterial species were tested for their susceptibility to the above samples. The microplate dilution and radiometric respiratory methods were used to determine the susceptibility testing of the samples against Mycobacterium smegmatis and Mycobacterium tuberculosis, respectively. The disc diffusion assay was used to determine the sensitivity of the samples, whilst the micro-dilution method was used for the determination of the minimal inhibition concentration (MIC) and the minimal microbicidal concentration (MMC) against fungi, Gram-positive and Gram-negative bacterial species. All the samples except compound 7 were found to be active to Mycobacterium smegmatis and the MIC ranged from 0.61 to 312.50μg/ml. Compound 4 showed the best activity against Mycobacterium tuberculosis exhibiting an MIC of 4.88μg/ml. The results of the diffusion test indicated that the crude extract from FCB, FCM as well as compounds 5 and 8 were able to prevent the growth of all tested (fungi, Gram-positive and Gram-negative bacteria) organisms. The inhibition effect of the crude extract from Ficus chlamydocarpa was observed on 10 (62.5\%) of the 16 tested microorganisms (excluding mycobacteria) whereas that of compounds 4, 2 and 3 was respectively noted on 14 (87.5\%), 8 (50.0\%) and 7 (39.9\%) of the tested microbial species. FCB was found to be more active than FCR on most of the tested organisms. The results provided evidence that the studied plants extract, as well as some of the isolated compounds might be potential sources of new antimicrobial drug.},
	number = {1},
	journal = {Journal of Ethnopharmacology},
	author = {Kuete, V. and Ngameni, B. and Simo, C.C. Fotso and Tankeu, R. Kengap and Ngadjui, B. Tchaleu and Meyer, J.J.M. and Lall, N. and Kuiate, J.R.},
	month = oct,
	year = {2008},
	keywords = {Antimicrobial activity, Compounds},
	pages = {17--24},
}

